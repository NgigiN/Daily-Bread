# Copy to .env on the VPS (never commit .env):
#   cp .env.example .env

# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Daily push recipients only (cron). Interactive commands are open to anyone.
TELEGRAM_CHAT_IDS=123456789,987654321

# Public HTTPS webhook (nginx → 127.0.0.1:5555)
WEBHOOK_URL=https://bible.samtama.lol/webhook
WEBHOOK_SECRET=generate-a-long-random-string

# In Docker Compose these are overridden to 0.0.0.0:5555 inside the container.
# Host publish remains 127.0.0.1:5555 only.
APP_HOST=127.0.0.1
APP_PORT=5555
