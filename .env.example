# Copy to .env and fill in your values:
#   cp .env.example .env

# From @BotFather when you created your bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated chat IDs for the daily push only (cron / daily_bread.py)
# Interactive commands work for anyone who starts the bot.
TELEGRAM_CHAT_IDS=123456789,987654321

# Public HTTPS webhook URL (nginx → uvicorn on APP_PORT)
WEBHOOK_URL=https://bible.samtama.lol/webhook

# Optional: secret Telegram sends as X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=

# Local bind for uvicorn (port 8000 is often taken on the server)
APP_HOST=127.0.0.1
APP_PORT=5555
